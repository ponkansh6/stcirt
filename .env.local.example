# Turso Database (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-database-username.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Generated locally by `pnpm participant-auth generate`:
# PARTICIPANT_PIN=0000
# PARTICIPANT_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Generated locally by `pnpm participant-auth generate --profile admin`:
# ADMIN_PRESENTATION_PIN=choose-a-private-admin-pin
# ADMIN_PRESENTATION_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional: session lifetime 1-90 days (default 30), failed name attempts/window (default 5)
PARTICIPANT_SESSION_DAYS=30
PARTICIPANT_RATE_LIMIT_NAME=5
